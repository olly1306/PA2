// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
varying vec3 normalMatrixed;
uniform mat4 ModelViewProjectionMatrix;
uniform mat4 NormalMatrix;
uniform vec3 light;
varying vec4 color;
attribute vec2 texCoord;
varying vec2 vTexCoord;
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent; // Вхідний тангента
varying vec3 vNormal;
varying vec3 vTangent;
varying vec3 vBitangent;


void main() {
    normalMatrixed = vec3(NormalMatrix * vec4(normal, 0.0));
    vec3 N = normalize(normalMatrixed);
    vec3 L = normalize(light - vertex);
    gl_Position = ModelViewProjectionMatrix * vec4(vertex,1.0);
    float lambertian = max(dot(N, L), 0.0);
    float specular = 0.0;
    if(lambertian > 0.0) {
        vec3 R = reflect(-L, N);      // Reflected light vector
        vec3 V = normalize(-vertex); // Vector to viewer
        // Compute the specular term
        float specAngle = max(dot(R, V), 0.0);
        specular=pow(specAngle,1.0);
    }
    vec3 ambientColor = vec3(.1, .1, 0.);
    vec3 diffuseColor = vec3(1., 1., 0.);
    vec3 specularColor = vec3(0.,0.,0.);
    color = vec4(0.9 * ambientColor +
                0.9 * lambertian * diffuseColor +
                0.9 * specular * specularColor, 1.0);
    vTexCoord = texCoord;

    vec3 N = normalize(mat3(NormalMatrix) * normal);
    vec3 T = normalize(mat3(NormalMatrix) * tangent);
    vec3 B = normalize(cross(N, T));
    T = normalize(cross(B, N));
    vNormal = N;
    vTangent = T;
    vBitangent = B;

    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;

// Fragment shader
const fragmentShaderSource = `
precision mediump float;
uniform sampler2D diffuseMap;
uniform sampler2D specularMap;
uniform sampler2D normalMap;
uniform vec3 ambientLight;
uniform vec3 directionalLight; // Додаткове світло
uniform vec3 constantLight;


#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

//uniform vec4 color;
varying vec4 color;
void main() {
    vec3 normal = texture2D(normalMap, vTexCoord).rgb * 2.0 - 1.0;
    vec3 lightDir = normalize(light - vPosition);

    // Diffuse
    vec3 diffuseColor = texture2D(diffuseMap, vTexCoord).rgb;
    float diffuse = max(dot(normal, lightDir), 0.0);

    // Specular
    vec3 viewDir = normalize(-vPosition);
    vec3 reflectDir = reflect(-lightDir, normal);
    vec3 specularColor = texture2D(specularMap, vTexCoord).rgb;
    float specular = pow(max(dot(viewDir, reflectDir), 0.0), 32.0);

    // Combine lighting
    vec3 color = constantLight + ambientLight * 1.5 + diffuseColor * diffuse * 1.5 + specularColor * specular;
    gl_FragColor = vec4(color, 1.0);

    vec3 normalFromMap = texture2D(normalMap, vTexCoord).rgb * 2.0 - 1.0;
    vec3 adjustedNormal = normalize(
        normalFromMap.x * vTangent +
        normalFromMap.y * vBitangent +
        normalFromMap.z * vNormal
    );
}`;